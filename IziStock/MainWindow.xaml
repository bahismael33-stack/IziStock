<mahapps:MetroWindow x:Class="IziStock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:local="clr-namespace:IziStock"
        xmlns:viewModels="clr-namespace:IziStock.ViewModels"
        mc:Ignorable="d"
        Title="IziStock" Height="600" Width="800" MinHeight="600" MinWidth="680"
        TitleCaps="False" GlowBrush="SkyBlue" Icon="Graphics/icons8_pos_terminal_96_ahu_icon.ico">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>
    <Grid>
        <ContentPresenter Content="{Binding CurrentViewModel}"/>
    </Grid>
</mahapps:MetroWindow>
