<UserControl x:Class="IziStock.Views.ViewQuantityAdjustments"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IziStock.Views"
             mc:Ignorable="d" 
             xmlns:mahapps="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:models="clr-namespace:IziStock.Models"
             xmlns:viewModels="clr-namespace:IziStock.ViewModels"
             d:DesignHeight="450" d:DesignWidth="800"
             x:Name="ViewQuantityChangesControl">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" 
                    Content="Retour au menu principal" Margin="15,5,5,5" Padding="10" Height="40" Command="{Binding ReturnToManageItems}"/>
        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Content="Voir les changements de quantité" FontWeight="Bold" FontSize="16" 
               HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <DataGrid Grid.Row="1" Grid.Column="0" Name="ItemsGrid" ItemsSource="{Binding Adjustments}" 
                  d:DataContext="{d:DesignInstance Type={x:Type models:QuantityAdjustment}}"
                  IsReadOnly="True" CanUserAddRows="False" AutoGenerateColumns="False" CanUserDeleteRows="False"
                  SelectionUnit="FullRow" CanUserSortColumns="False"
                  SelectionMode="Single" GridLinesVisibility="All" 
                  RowHeaderWidth="0" Background="LightGray" BorderBrush="Gray" BorderThickness="1"
                  ColumnHeaderStyle="{StaticResource NoCapsColumnHeader}">
            <DataGrid.Style>
                <Style BasedOn="{StaticResource MetroDataGrid}" TargetType="{x:Type DataGrid}">
                    <Setter Property="AlternatingRowBackground" Value="{DynamicResource GrayBrush10}" />
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding FriendlyDateTime}"/>
                <DataGridTextColumn Header="Montant modifié" Binding="{Binding AmountChanged}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ajusté par" Binding="{Binding UserName}"/>
                <DataGridCheckBoxColumn Header="Achat de stock ?" Binding="{Binding WasAdjustedForStockPurchase}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Explication" Binding="{Binding Explanation}"/>
                <DataGridTemplateColumn Header="" CanUserResize="False" Width="*" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Modifier" Width="150" HorizontalAlignment="Left" Margin="5,0,0,0"
                                                Command="{Binding ElementName=ViewQuantityChangesControl, Path=DataContext.AdjustExplanation}"
                                                CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
